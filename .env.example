# Read-only lookups with no keys
STRIKE_WALLET_ADDRESS=

# API wallet (create with `node dist/index.js keygen`, register the public key at https://app.strikefinance.org/api-keys)
STRIKE_API_PUBLIC_KEY=
STRIKE_API_PRIVATE_KEY=

# Trading (off by default)
STRIKE_ENABLE_TRADING=false
STRIKE_MAX_ORDER_NOTIONAL_USD=1000
STRIKE_NETWORK=mainnet
